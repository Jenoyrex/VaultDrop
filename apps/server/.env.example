NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vaultdrop:vaultdrop@localhost:5432/vaultdrop?schema=public
JWT_SECRET=change-this-to-a-random-32-character-minimum-secret
JWT_EXPIRES_IN=15m
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
CORS_ORIGIN=http://localhost:3000
MAX_UPLOAD_BYTES=104857600

# Optional — rate limiting for /auth/register, /auth/login, and
# /auth/check-username. Falls back to built-in defaults (20 requests per
# 15 minutes for register/login, 10 per 15 minutes for check-username) if
# unset.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Only required when STORAGE_DRIVER=cloud
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_FORCE_PATH_STYLE=false
CLOUD_STORAGE_ACCESS_KEY_ID=
CLOUD_STORAGE_SECRET_ACCESS_KEY=
