NODE_ENV=development
PORT=4000
# Pooled connection — used by the running application (Prisma Client) at
# runtime. For local/docker-compose Postgres, DATABASE_URL and DIRECT_URL
# can be the same value. For a pooled provider (e.g. Neon, or any
# PgBouncer-fronted Postgres), this must be the pooled endpoint.
DATABASE_URL=postgresql://vaultdrop:vaultdrop@localhost:5432/vaultdrop?schema=public
# Direct/unpooled connection — used only by the Prisma CLI (migrate, db
# pull, etc.), never by the running application. Required as a distinct
# value for pooled providers: their pooled endpoint doesn't support the
# session-level advisory locks Prisma's migration engine relies on.
DIRECT_URL=postgresql://vaultdrop:vaultdrop@localhost:5432/vaultdrop?schema=public
# CHANGE THIS before deploying to production — this placeholder value is
# explicitly rejected at boot when NODE_ENV=production.
JWT_SECRET=change-this-to-a-random-32-character-minimum-secret
JWT_EXPIRES_IN=15m
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
CORS_ORIGIN=http://localhost:3000
MAX_UPLOAD_BYTES=104857600

# Optional — rate limiting for /auth/register, /auth/login, and
# /auth/check-username. Falls back to built-in defaults (20 requests per
# 15 minutes for register/login, 10 per 15 minutes for check-username) if
# unset.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Optional — per-user (not per-IP) API abuse-protection limiters, applied
# to every authenticated /vaults, /folders, and /files route. Falls back
# to a 5-minute window with 300 requests/window for general API calls,
# 30/window shared by upload + upload-encrypted, and 60/window shared by
# download + preview, if unset. Upload/download budgets are layered on
# top of the general one, not merged with it. Uses the same in-memory
# store as the auth limiters above — see rate-limit.ts for the
# multi-instance-deployment caveat that implies.
API_RATE_LIMIT_WINDOW_MS=300000
API_RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=30
DOWNLOAD_RATE_LIMIT_MAX=60

# Optional — number of reverse-proxy hops to trust for X-Forwarded-For
# when determining the real client IP (Express's "trust proxy" setting).
# Defaults to 0 (no proxy trusted, direct connections only), correct for
# local dev and any deployment with no reverse proxy in front. If the
# server sits behind a reverse proxy/load balancer, set this to the
# number of hops between the client and this server (typically 1) —
# otherwise rate limiting keys on the proxy's IP for every request.
TRUST_PROXY_HOPS=0

# Only required when STORAGE_DRIVER=cloud
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_FORCE_PATH_STYLE=false
CLOUD_STORAGE_ACCESS_KEY_ID=
CLOUD_STORAGE_SECRET_ACCESS_KEY=
