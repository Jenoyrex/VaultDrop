# Local dev: the API's own origin. localhost:3000 -> localhost:4000 is
# same-site, so the SameSite=Lax session cookie is still sent.
# Production (Netlify): set this to /api so requests go through the
# same-origin proxy defined in apps/web/netlify.toml.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional. Only needed to verify domain ownership in Google Search
# Console via its "HTML tag" method. Set this to the token Search Console
# generates for that method (the content="..." value, not the whole
# <meta> tag) — Next renders the required meta tag automatically when
# it's set, and renders nothing at all when it's unset.
GOOGLE_SITE_VERIFICATION=
