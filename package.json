{
  "name": "vaultdrop",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @vaultdrop/server prisma:generate",
    "db:migrate": "pnpm --filter @vaultdrop/server prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @vaultdrop/server prisma:migrate:deploy"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^1.20.6",
      "postcss": "^8.5.23",
      "nanoid": "^3.3.18",
      "sharp": "^0.35.4"
    }
  }
}